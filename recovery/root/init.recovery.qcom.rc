import /init.recovery.wifi.rc
import /init.recovery.prepdecrypt.rc

on early-init
    # Qualcomm's Mapper5/SnapAlloc path produces native buffers that can be
    # imported by both Adreno EGL and the KMS display backend.
    setprop vendor.gralloc.enable_snapalloc true

service aera-graphics-allocator /vendor/bin/hw/vendor.qti.hardware.display.allocator-service
    class hal
    seclabel u:r:recovery:s0
    user root
    group root graphics
    capabilities SYS_NICE
    # SnapAlloc must parse its tables using the matching vendor JsonCpp ABI.
    setenv LD_LIBRARY_PATH /vendor/lib64:/system/lib64

# The installed Xiaomi partitions supply ABI-matched Qualcomm audio libraries;
# these renamed daemon copies provide stable init entry points in recovery.
service aera-pd-mapper /vendor/bin/aera-pd-mapper
    class core
    disabled
    seclabel u:r:recovery:s0
    user system
    group system
    setenv LD_LIBRARY_PATH /vendor/aera-audio-abi:/vendor/aera-stock-odm-lib64:/vendor/aera-stock-lib64:/vendor/lib64:/system/lib64

service aera-dspservice /vendor/bin/aera-dspservice
    class hal
    disabled
    seclabel u:r:recovery:s0
    user system
    group system wakelock oem_2908
    capabilities BLOCK_SUSPEND
    setenv LD_LIBRARY_PATH /vendor/aera-audio-abi:/vendor/aera-stock-odm-lib64:/vendor/aera-stock-lib64:/vendor/lib64:/system/lib64
    interface aidl vendor.qti.hardware.dsp.IDspService/default

service aera-audioadsprpcd /vendor/bin/aera-audioadsprpcd audiopd adsp
    class main
    disabled
    seclabel u:r:recovery:s0
    user media
    group media
    setenv LD_LIBRARY_PATH /vendor/aera-audio-abi:/vendor/aera-stock-odm-lib64:/vendor/aera-stock-lib64:/vendor/lib64:/system/lib64

service aera-agm-service /system/bin/aera-audio-service --thales-stock-agm
    class main
    disabled
    seclabel u:r:recovery:s0
    user root
    group root system audio media wakelock
    setenv LD_LIBRARY_PATH /vendor/aera-audio-abi:/vendor/aera-stock-odm-lib64:/vendor/aera-stock-lib64:/vendor/lib64:/system/lib64
    setenv ANDROID_ROOT /system
    setenv ANDROID_DATA /data
    interface aidl vendor.qti.hardware.agm.IAGM/default
    interface aidl vendor.qti.hardware.pal.IPAL/default

service aera-audio-bootstrap /system/bin/aera-audio-bootstrap
    class core
    disabled
    oneshot
    seclabel u:r:recovery:s0
    user root
    group root system audio media wakelock

on init
    start vendor.boot-qti
    setprop prepdecrypt.setpatch true

on early-fs
    write /proc/sys/walt/sched_lib_name "recovery,magiskboot,Updater,updater,update_engine_sideload"
    write /proc/sys/walt/sched_lib_mask_force 255

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion
    # Its SSD listener opens by-name/ssd, which ueventd may not have made yet.
    wait /dev/block/bootdevice/by-name/ssd 10
    start vendor.qseecomd
    mkdir /mnt/vendor 0775 shell system
    mkdir /mnt/vendor/persist 0775 shell system
    mkdir /tmp/persist 0775 shell system
    mount none /tmp/persist /mnt/vendor/persist bind rec

on post-fs
    start odm.variant-script

on boot
    setprop sys.usb.config adb

# qseecomd is up, so the HALs that reach a trustlet through it can follow.
on property:vendor.sys.listeners.registered=true
    start vendor.gatekeeper_default

# variant-script has copied this SKU's files into /odm.
on property:aera.variant.files_copied=1
    start odm.vibratorfeature-service
    start odm.touch_report

# eSE probes its hardware once at startup. Starting before the NFC modules
# leaves it permanently absent; Weaver also caches a failed TEE session.
on property:vendor.sys.listeners.registered=true && property:twrp.modules.loaded=true && property:aera.variant.files_copied=1 && property:crypto.ready=1
    start vendor.secure_element
    start odm.weaver-service

on property:twrp.modules.loaded=true
    # Keep modem firmware outside /vendor: mounting over firmware_mnt hides
    # the recovery's packaged eSE trustlets, which are not in every modem image.
    mkdir /firmware 0755 root shell
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337
    # Prepare crypto only after the modem mount has completed, so its firmware
    # links are ready before secure-element startup.
    start odm.prepdecrypt
    # Load ADSP firmware for PMIC
    wait /sys/kernel/boot_adsp/boot
    write /sys/kernel/boot_adsp/boot 1
    # This make USB-OTG work
    wait /sys/kernel/boot_adsp/ssr
    write /sys/kernel/boot_adsp/ssr 1
    wait /sys/class/power_supply/battery
    start vendor.health-default
    setprop aera.firmware.mounted true

# Stock audio mounts and daemons are intentionally kept after the encryption
# critical path so they cannot interfere with KeyMint, Weaver or decryption.
on property:post.decrypt.modules=true
    start aera-audio-bootstrap

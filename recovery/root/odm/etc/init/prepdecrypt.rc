# /odm is the ramdisk directory while init parses this file, but recovery later
# mounts the device's logical odm partition over it. Preserve the recovery-only
# script before that mount hides /odm/bin/prepdecrypt.sh.
on early-init
    copy /odm/bin/prepdecrypt.sh /sbin/prepdecrypt.sh
    chmod 0755 /sbin/prepdecrypt.sh

service odm.prepdecrypt /system/bin/sh /sbin/prepdecrypt.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0
